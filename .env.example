# AI 서비스 환경 변수 예제 (TASK-02)
# 실제 값은 이 파일에 적지 않는다. 실제 값은 docs/info.txt(저장소 밖, 사용자 관리)에 보관한다.

# --- LLM / 외부 API 키 ---
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
SERPER_API_KEY=YOUR_SERPER_API_KEY
UNDETECTABLE_AI_API_KEY=YOUR_UNDETECTABLE_AI_API_KEY

# --- Gemini 모델 폴백 목록 (필요한 만큼 MODEL_NAME0~9 사용, 비워두면 해당 순번 건너뜀) ---
MODEL_NAME0=
MODEL_NAME1=YOUR_PRIMARY_MODEL_NAME
MODEL_NAME2=YOUR_FALLBACK_MODEL_NAME
MODEL_NAME3=

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_COLLECTION_NAME=legal_documents

# --- Redis (laws_embedding.py 재임베딩 작업 시에만 조건부 필요, TASK-11) ---
# 루트 docker-compose.yml의 redis는 --profile reembed로 켤 때만 뜨고
# requirepass가 걸려 있다. 비밀번호는 루트 .env의 REDIS_PASSWORD와 맞춘다.
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0

# --- RunPod 자체 모델 (선택. 비우면 자체 모델 분기를 건너뛰고 Gemini 판정만 사용) ---
RUNPOD_URL=
RUNPOD_API_KEY=

# --- YouTube 쿠키/PO 토큰 (TASK-07에서 코드에 실제로 연결 예정) ---
YOUTUBE_COOKIE_PATH=YOUR_COOKIE_FILE_PATH
YOUTUBE_PO_TOKEN=
